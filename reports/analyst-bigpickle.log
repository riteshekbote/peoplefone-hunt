components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer

  responses:
    UnauthorizedError:
      description: Access token is missing or invalid
    NotFoundError:
      description: Resource not found
    BadRequestError:
      description: Request is invalid
    NotAllowedError:
      description: Method not supported for this resourse
    TooManyRequestsError:
      description: Rate limit error
    ServiceUnavailableError:
      description: Service Unavailable

  schemas:
    SmsStatus:
      type: string
      enum:
        - accepted
        - rejected
        - scheduled
        - queued
        - sending
        - sent
        - receiving
        - received
        - delivered
        - undelivered
        - failed
        - canceled
    SmsDirection:
      type: string
      enum:
        - MO
        - MT
    SendMessageRequest:
      type: object
      required:
        - text
        - to
      properties:
        callbackUrl:
          type: string
          format: uri
          maxLength: 2048
          example: https://myserver.com/send/callback/here
          description: Overwrites the default callback url (if configured on account level) for delivery receipts for this message
        text:
          type: string
          minLength: 1
          maxLength: 1530
          description:  
            The short message content . The most compact encoding possible will automatically be determined. 
            If message text includes any non GSM-7 characters then system will automatically select UCS-2 encoding
            while submitting the SMS to SMS provider.
            <br>SMS messages sent with 16-bit encoding (UTF-8) are limited to 70 characters per message. 16-bit UCS-2 encoding allows special characters.
            Characters count in text is up to 1530 for a GSM7 message and 670 for a UNICODE to limit maximum number of concatened SMS to 10
        to:
          uniqueItems: true
          minItems: 1
          type: array
          items:
            type: string
            pattern: '^\+?[1-9]\d{1,14}$'
          description: Message's recipient(s) numbers in E.164 format
        from:
          type: string
          pattern: ^(?<e164>\+?[1-9]\d{1,14})|(?<alphanumeric>(?=.*[a-zA-Z])([a-zA-Z0-9 !"#%&'()*\+,\-.\/:;<=>?]{1,11}))$
          description: | 
            Message sender number having either E.164 format (max 15 digits with optional leading '+') or alphanumeric (max 11 characters).
            Please contact Peoplefone support to verify if you can use this field and what are the allowed values for your account.
        scheduledDeliveryTime:
          type: string
          format: date-time
          description: Future (scheduled) message delivery time.
          #example: 2023-05-01T04:00:00+0200
        validityPeriod:
          type: integer
          format: int32
          minimum: 5
          maximum: 14400
          description: |
            Validity period indicates how long system shall try to deliver message(s) before failing with an error. 
            Client must avoid validity periods of shorter than 5 seconds and longer then 24 hours.
      description: Send SMS request
    BaseErrorInfo:
      type: object
      required:
        - code
        - message
        - timestamp
      properties:
        code:
          type: integer
          minimum: 100
          maximum: 600
        message:
          type: string
        timestamp:
          type: string
          format: date-time
          description: Time of the error.
      description: The error details
    BaseResponse:
      type: object
      properties:
        error:
          $ref: '#/components/schemas/BaseErrorInfo'
    SendMessageResponse:
      type: object
      properties:
        messageId:
          type: string
          description: System defined message ID. This ID shall be used by client for tracking purposes.
        status:
          $ref: '#/components/schemas/SmsStatus'
        to:
          type: string
          pattern: '^\+?[1-9]\d{1,14}$'
        receivedAt:
          type: string
          format: date-time
          description: Time of receiving send SMS request by API (in case of direction=MO) or SMS message from network (direction=MT)
        error:
          $ref: '#/components/schemas/BaseErrorInfo'
    SendMessagesListResponse:
