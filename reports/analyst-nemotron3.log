    /subscription:
        post:
            tags:
                - Acquire calls
            summary: subscribe to call state notification for the given user
            description: |
                This function allows to create a callback subscription for call state changes for the given user. 
                
                _note: the owner 'entity' must be of type 'user', 
                and this user must be part of the account bound to the bearer token_
                
                If the provided callback URL is already used for this user then it will have no effect 
                and it will return the existing subscription ID.
                
                _note: if the same callback URL is used for different user then the service will not check and
                you will receive notification for both users which could lead to inconsistancies on your side_
            requestBody:
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/SubscriptionRequest'
                        examples:
                            default:
                                summary: subscribe
                                value:
                                    owner:
                                        identifier: "1234"
                                        type: "user"
                                    callbackUrl: "https://my-domain.com/my-callback-path"
            callbacks:
                notify:
                    "{$request.body#/callbackUrl}":
                        post:
                            requestBody:
                                content:
                                    application/json:
                                        schema:
                                            $ref: '#/components/schemas/SubscriptionNotification'
                                        examples:
