openapi: 3.1.1
info:
  title: "Queue API | Stats v1"
  description: |
    ## Overview
    Queue and agent statistics.

    Period limits for statistics: maximum 6 months.

    ## Documentation
    This API provides queue and agent statistics, agent login/logout actions on queues, and logged agent listing.

    Core concepts:
    - Queue and agent identifiers use the common Entity schema (EntityType `queue` or `user` for agent).
    - A permanent member (`permanentMembership: true`) is an agent configured as a persistent member of a queue. Such agents are automatically logged in and remain logged until removed from the queue configuration.

    ## Changelog
    ### v1.2.0 - 2026-06-11
    * Add endpoint to list agents logged into a queue
    ### v1.1.0 - 2026-05-21
    * Add agent login and logout action endpoints
    ### v1.0.0 - 2026-02-09
    * Initial contract.
  version: "1.2.0"
servers:
  - url: https://call-api.peoplefone.com/customer/queue/v1/
    description: Production
tags:
  - name: "1. Queue statistics"
    description: "Queue summary statistics."
  - name: "2. Agent statistics"
    description: "Agent call and login statistics."
  - name: "3. Agent actions"
    description: "Agent login/logout actions on queues."
paths:
  /queues/stats:
    post:
      tags:
        - "1. Queue statistics"
      summary: "Queue summary statistics"
      description: |
        Returns queue summary statistics over a period, aggregated by a time bucket.
        Statistics cover all agents in the queue. Use /agents/stats with a queue filter for per-agent breakdown.
        Optionally filter by call outcomes.
        Only completed calls are included; calls still in progress are excluded.
        All metrics are bucketed by setupTime (time the call entered the queue), ensuring that totalIncomingCalls = totalAnsweredCalls + totalAbandonedCalls + totalOverflowedCallsByTimeout + totalOverflowedCallsByCapacity within each bucket.
      operationId: getQueueSummaryStats
      requestBody:
        content:
          application/json:
            schema:
