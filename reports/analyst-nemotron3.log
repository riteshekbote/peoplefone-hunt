openapi: 3.1.1
info:
  title: "Configuration API | v1"
  description: |
    ## Overview
    Provides access to view and configure Peoplefone VoIP / PBX elements:
    Smart Routing, Groups, IVR/Announcement, Lines, Manual Routing, Numbers,
    Queues, Time Routing, and Users.

    ## Documentation
    Configuration API for customer PBX management.

    ## API Status: Beta
    This API is still in development. Backward compatibility is not guaranteed
    while the contract remains in beta; breaking changes may still occur.

    ## Common Errors
    These errors may be returned for any endpoint.
    They are not repeated per operation.

    | Status | Description | Template reference |
    | --- | --- | --- |
    | 400 | Malformed or invalid request | BadRequestError |
    | 401 | Missing or invalid authentication | UnauthorizedError |
    | 403 | Action not allowed | ForbiddenError |
    | 404 | Resource or route not found | ResourceNotFoundError |
    | 429 | Rate limit or quota exceeded | TooManyRequestsError |
    | 500 | Unexpected server failure | InternalServerError |
    | 503 | Dependency unavailable | ServiceUnavailableError |

    See the [Error response catalogue](#/99.%20Error%20catalogue) for response schemas and examples (common and operation-specific errors).
    Operation-specific errors (405, 409, 415, 418, 419, 422) are also documented
    per operation when applicable.

    ## Changelog
    ### v1.0.0 - 2026-07-17 - beta
    * Initial beta release of the Configuration API contract.
    * Covers Destinations, Smart Routing, Groups, IVR/Announcement, Queues,
      Numbers, Manual Routing, Time Routing, and Users.

  version: "1.0.0 beta"

servers:
  - url: https://configuration-api.peoplefone.com/customer/voip/v1
    description: Production

security:
  - bearerAuth: []

tags:
  - name: "1. Destinations"
    description: "Available routing destinations."
  - name: "2. CallForwarding"
    description: "Call Forwarding configuration, including forwarding rules and exceptions."
  - name: "3. Smart Routing"
    description: "Smart Routing configuration."
  - name: "4. Groups"
    description: "Group configuration and members."
  - name: "5. IVR/Announcement"
    description: "IVR menus and announcements."
  - name: "6. Queues"
    description: "Queue configuration and agents."
  - name: "7. Numbers"
    description: "Number blocks, DIDs, and contacts."
  - name: "8. Manual Routing"
    description: "Manual routing rules."
  - name: "9. Time Routing"
    description: "Time-based routing, exceptions, and schedules."
  - name: "10. Users"
    description: "User configuration."
  - name: "99. Error catalogue"
    description: "Documentation-only error response catalogue."

paths:
  /destinations:
    get:
      tags:
        - "1. Destinations"
      summary: List all destinations
      operationId: listDestinations
      description: >
        Returns the available destinations.  
        Two JSON layouts are being evaluated (grouped vs flat); both are shown below.
      parameters:
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageNumber'
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageSize'
        - name: types
          in: query
          description: >
            Optional list of destination types to return.

            Accepts comma-separated values (`?types=queue,ivr`) or
            repeated keys (`?types[]=queue&types[]=ivr`).
            

            Available: group, timeRouting, queue, voicemail, ivr, manualRouting, user, smartRouting
          required: false
          schema:
            type: string
            example: queue,ivr

      responses:
        "200":
          description: OK – flat list
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DestinationListResponse'
              examples:
                default:
                  summary: "Destination list"
                  value:
                    data:
                      - identifier: "20011"
                        name: "Standard user 11"
                        type: "user"
                        internalNumber: null
                      - identifier: "1612"
                        name: "Test queue 12"
                        type: "queue"
                        internalNumber: "212"
                    pageNumber: 1
                    pageSize: 2
                    totalElements: 2
                    totalPages: 1
                    last: true

  /virtualUsers/{identifier}/callforwarding:
    get:
      tags:
        - "2. CallForwarding"
      summary: Get call forwarding by Virtual User ID
      description: >
        Retrieves the call forwarding configuration for a specific user.
      parameters:
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageNumber'
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageSize'
        - name: identifier
          in: path
          required: true
          schema:
            type: string
            description: Virtual User ID
            example: 12345
      responses:
        "200":
          description: Call forwarding details
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallForwardingListResponse'
              examples:
                default:
                  summary: "Call forwarding"
                  value:
                    data:
                      - status: 1
                        condition_src_type: "number"
                        condition_src_id: null
                        condition_called_party: null
                        condition_calling_party: null
                        type: "immediate"
                        type_of_action: "reject_busy"
                        timer: 0
                        destination: null
                        type_of_destination: "number"
                        condition_called_party_type: 0
                    pageNumber: 1
                    pageSize: 15
                    totalElements: 1
                    totalPages: 1
                    last: true

  /virtualUsers/{identifier}/callforwarding/create:
    post:
      tags:
        - "2. CallForwarding"
      summary: Create call forwarding rule for Virtual User ID
      description: >
        Creates a new call forwarding rule for a specific user.
      parameters:
        - name: identifier
          in: path
          required: true
          schema:
            type: string
          description: Virtual User ID
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CallForwardingCreateRequestBody'
            examples:
              default:
                summary: "Create call forwarding"
                value:
                  rule: "immediate"
                  action: "call_forwarding"
                  destination: "4233159295"
                  condition_src_type: 0
                  condition_calling_party: null
                  condition_src_id: null
                  destination_type: "other_number"
                  condition_called_party_type: 0

  /virtualUsers/{identifier}/callforwarding/{callforwarding_id}/status:
    put:
      tags:
        - "2. CallForwarding"
      summary: Update the status of a call forwarding rule
      description: >
        Updates the status of an existing call forwarding rule for a specific user.
      parameters:
        - name: identifier
          in: path
          required: true
          description: Virtual User ID
          schema:
            type: string

        - name: callforwarding_id
          in: path
          required: true
          description: Call forwarding ID
          schema:
            type: string

      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - status
              properties:
                status:
                  type: boolean
                  description: Whether the call forwarding rule is active.
                  example: false
            examples:
              default:
                summary: Update call forwarding status
                value:
                  status: false

      responses:
        200:
          description: Call forwarding status updated successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallForwardingUpdateResponse'
              example:
                code: 200
                message: Updated
                timestamp: "2026-08-27T08:18:56.794Z"

  /virtualUsers/{identifier}/callforwarding/{callforwarding_id}:
    put:
      tags:
        - "2. CallForwarding"
      summary: Update call forwarding rule for Virtual User ID
      description: >
        Updates an existing call forwarding rule for a specific user.
      parameters:
        - name: identifier
          in: path
          required: true
          schema:
            type: string
          description: Virtual User ID
        - name: callforwarding_id
          in: path
          required: true
          schema:
            type: string
            description: Call forwarding ID
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CallForwardingCreateRequestBody'
            examples:
              default:
                summary: "Create call forwarding"
                value:
                  rule: "immediate"
                  action: "call_forwarding"
                  destination: "+4233159295"
                  condition_called_party: "+41815528260"
                  destination_type: "other_number"
      responses:
        "200":
          description: Call forwarding details
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallForwardingUpdateResponse'
              examples:
                default:
                  summary: "Call forwarding"
                  value:
                    - code: 200
                      message: "Updated"
                      timestamp: "2026-08-27T05:59:59.592Z"
    delete:
      tags:
        - "2. CallForwarding"
      summary: Delete the call forwarding rule
      description: >
        Delete an existing call forwarding rule for a specific user.
      parameters:
        - name: identifier
          in: path
          required: true
          schema:
            type: string
          description: Virtual User ID
        - name: callforwarding_id
          in: path
          required: true
          schema:
            type: string
            description: Call forwarding ID to be deleted

  /smart-routings:
    get:
      tags:
         - "3. Smart Routing"
      summary: List all smart routings
      operationId: listSmartRoutings
      description: |
         Returns a list of all configured Smart Routing entries for the customer.
  
         Each entry includes:
         - Identifier, name, and type
         - Timeout settings and fallback behavior
         - Destination details (if applicable)
  
         This endpoint is typically used to display available Smart Routing configurations or to audit routing behaviors integrated with third-party systems.
      parameters:
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageNumber'
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageSize'
      responses:
        "200":
           description: "Smart Routing list"
           content:
             application/json:
               schema:
                 $ref: '#/components/schemas/SmartRoutingListResponse'
               examples:
                 default:
                   summary: "Smart Routing list"
                   value:
                     data:
                       - identifier: "1576"
                         name: "zapier registration example"
                         type: "smartRouting"
                         internalNumber: "201"
                     pageNumber: 1
                     pageSize: 15
                     totalElements: 1
                     totalPages: 1
                     last: true

  /smart-routings/{identifier}:
    get:
      tags:
        - "3. Smart Routing"
      summary: Get Smart Routing by ID
      operationId: getSmartRoutingByIdentifier
      description: |
        Retrieves the configuration of a specific Smart Routing entry using its unique identifier.

        The response includes:
        - Name and type of the routing
        - Target URL (if applicable)
        - Timeout handling strategy (forward or reject)
        - Fallback destination if forwarding is configured

        This endpoint is useful for managing integrations with external services or platforms such as webhooks or automation tools.
      parameters:
        - name: identifier
          in: path
          required: true
          schema:
            type: string
          description: Smart Routing ID
      responses:
        "200":
          description: Smart Routing details
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SmartRoutingResponse'
              examples:
                ForwardOnTimeout:
                  value:
                    identifier: "1576"
                    name: "zapier registration example"
                    internalNumber: "201"
                    type: "smartRouting"
                    url: null
                    waitingTime:
                      maxWaitSeconds: 10
                      action: "forward"
                      destination:
                        identifier: "763"
                        name: "Test group 63"
                        type: "group"
                        internalNumber: "263"
                DropCallOnTimeout:
                  value:
                    identifier: '1576'
                    name: 'zapier registration example '
                    internalNumber: "201"
                    type: 'smartRouting'
                    url: null
                    waitingTime:
                      maxWaitSeconds: 10
                      action: "reject"
                      destination: null

  /groups:
    get:
      tags:
         - "4. Groups"
      summary: List all groups
      operationId: listGroups
      description: |
         Retrieves a paginated list of all configured groups within the customer’s PBX environment.

         Each group entry includes:
         - Unique identifier
         - Group name
         - Type (e.g., `group`)

         Groups are typically used to route calls to multiple users simultaneously or in sequence.
         This endpoint is commonly used in administrative portals for managing group-based call handling configurations.
      parameters:
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageNumber'
        - $ref: 'template/v202607-base-template.yml#/components/parameters/PageSize'
      responses:
        "200":
           description: A list of groups with pagination info
           content:
             application/json:
               schema:
                 $ref: '#/components/schemas/GroupListResponse'
               examples:
                 withData:
                   summary: A list of groups
                   value:
                     data:
                       - identifier: "2"
                         name: "test"
                         type: "group"
                     pageNumber: 1
                     pageSize: 15
                     totalElements: 1
                     totalPages: 1
                     last: true
                 empty:
                   summary: No groups found
                   value:
                     data: []
                     pageNumber: 1
                     pageSize: 15
                     totalElements: 0
                     totalPages: 1
                     last: true

    post:
      tags:
         - "4. Groups"
      summary: Create a new group
      operationId: createGroup
      description: |
         Creates a new group with the specified configuration.
         On success, returns a CreatedResourceResponse with a human-readable message, the new resource identifier, numeric code and timestamp.
      requestBody:
