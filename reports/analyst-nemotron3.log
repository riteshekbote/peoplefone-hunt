components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer

  responses:
    UnauthorizedError:
      description: Access token is missing or invalid
    NotFoundError:
      description: Resource not found
    BadRequestError:
      description: Request is invalid
    NotAllowedError:
      description: Method not supported for this resourse
    TooManyRequestsError:
      description: Rate limit error
