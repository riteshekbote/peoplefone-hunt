openapi: 3.1.1
info:
    title: call | Call Management | v1
    description: |
        Call Management API to act on existing peoplefone HOSTED calls
        
        ## Proposed function are of two kinds:
        - a way to acquire current call for a given user
        - action to interact with a given call
        
        ## Change log of v1:
        __v1.0.0__
        - way to get list of active call
        - action to blind transfer, hold and unhold a given call
        
        __v1.1.0__
        - subscription to be notified of call state changes (beta version)
        - add details in the call info (state, direction, remote party)
        
        __v1.1.1__
        - move from openapi 3.0.0 to 3.1.1

        __v1.1.2__
        - rename the contract title to fit guidelines
        - grouping endpoint by context

        __v1.2.0__
        - apply review changes, subscription final version
        
        __v1.2.1__
        - fix typo in the contract

        _note: changes to major version will apply only if a change break backward compatibility of a published API_
    version: 1.2.1
servers:
    - url: https://call-api.peoplefone.com/customer/call-management/v1
paths:
    /call:
        post:
            tags:
                - Acquire calls
            summary: Get active call for the given user
            description: |
                This function allows to acquire the list of active calls for the given user.
                
                This is not the best way to acquire calls as it is in polling mode only, however it can
                be useful to have this method available for integration purpose.
                
                It is recommended to use the subscription way to acquire calls instead.
                
                _note: the owner 'entity' must be of type 'user', 
                and this user must be part of the account bound to the bearer token_
            requestBody:
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/ListCallRequestBody'
                        examples:
                            default:
                                summary: list call
                                value:
                                    owner:
                                        identifier: "1234"
                                        type: user
            responses:
                '200':
                    description: Success
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/ListCallResponse'
                            examples:
                                oneCall:
                                    summary: One Call confirmed
                                    value:
                                        data:
                                            - callId: "abcd"
                                              state: "confirmed" 
                                              direction: "incoming"
                                              remoteParty:
                                                type: "number"
                                                identifier: "+41215522000"
                                        pageNumber: 1
                                        pageSize: 1
                                        totalElements: 1
                                        totalPages: 1
                                        last: true
                                twoCall:
                                    summary: Two Calls
                                    value:
                                        data:
                                            - callId: "1"
                                              state: "terminated" 
                                              direction: "incoming"
                                              remoteParty:
                                                type: "number"
                                                identifier: "+41215522000"
                                            - callId: "2"
                                              state: "confirmed"
                                              direction: "outgoing"
                                              remoteParty:
                                                  type: "number"
                                                  identifier: "+41445522000"
                                        pageNumber: 1
                                        pageSize: 2
                                        totalElements: 2
                                        totalPages: 1
                                        last: true
                '400':
                    $ref: 'template/v202504-template.yml#/components/responses/BadRequestError'
                '401':
