                                                value:
                                                    action: "notify"
                                                    owner:
                                                        identifier: "1234"
                                                        type: "user"
                                                    availability: "busy"
                                                    calls: 
                                                        - callId: "abcd"
                                                          state: "confirmed"
                                                          direction: "incoming"
                                                          remoteParty:
                                                              type: "number"
                                                              identifier: "+41215522000"
                                            twoCall:
                                                summary: notify two call
                                                value:
                                                    action: "notify"
                                                    owner:
                                                        identifier: "1234"
                                                        type: "user"
                                                    availability: "busy"
                                                    calls: 
                                                        - callId: "1"
                                                          state: "terminated"
                                                          direction: "incoming"
                                                          remoteParty:
                                                              type: "number"
                                                              identifier: "+41215522000"
                                                        - callId: "2"
                                                          state: "confirmed"
                                                          direction: "outgoing"
                                                          remoteParty:
                                                              type: "number"
                                                              identifier: "+41445522000"
                            responses:
                                '200':
                                    description: |
                                        Your server returns this code if it accepts the callback, 
                                        if not the subscription will be removed
            responses:
                '201':
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/SubscriptionRef'
                '400':
                    $ref: 'template/v202504-template.yml#/components/responses/BadRequestError'
                '401':
                    $ref: 'template/v202504-template.yml#/components/responses/UnauthorizedError'
                '403':
                    $ref: 'template/v202504-template.yml#/components/responses/ForbiddenError'
                '404':
                    $ref: 'template/v202504-template.yml#/components/responses/NotFoundError'
                '405':
                    $ref: 'template/v202504-template.yml#/components/responses/NotAllowedError'
                '418':
                    $ref: 'template/v202504-template.yml#/components/responses/UnexpectedEntityError'
                '429':
                    $ref: 'template/v202504-template.yml#/components/responses/TooManyRequestsError'
                '500':
                    $ref: 'template/v202504-template.yml#/components/responses/ServerInternalError'
                '503':
                    $ref: 'template/v202504-template.yml#/components/responses/ServiceUnavailableError'
    /subscription/{id}:
