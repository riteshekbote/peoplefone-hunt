openapi: 3.0.0
info:
  title: SMS GW API
  description: |
      Communication between the Peoplefone SMS Gateway, SMS client app / webhook endpoint and SMS provider to handles SMS messaging
      
      Sending SMS message sequence:<pre>
      SMS client app --  [sms_message, callback_url] --> API GW -> + token -> SMS GW --  [sms_message]    --> SMS Provider
      SMS client app <-- [sms_message_resp]              SMS GW <-- [submit_sms_resp] -- SMS Provider</pre>
      
      Sending SMS delivery report sequence:<pre>
      SMS Provider --  [delivery_report] --> SMS GW --  [smsStatusUpdateEvent]    --> callback_url</pre>

  version: 1.0.0
servers:
  - url: https://api.peoplefone.com/customer/sms
paths:
  /v1/sms/messages/status/{messageId}:
    get:
      summary: Get sms message status
      parameters:
      - name: messageId
        in: path
        description: the sms message identifier
        required: true
        schema:
          type: string
      responses:
        '200':
          description: Success
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SendMessageStatusResponse'
        '401':
            $ref: '#/components/responses/UnauthorizedError'
        '404':
            $ref: '#/components/responses/NotFoundError'
      security:
      - bearerAuth: []
  /v1/sms/messages/{messageId}:
    get:
      summary: Get sms message details
      parameters:
      - name: messageId
        in: path
        description: the sms message identifier
        required: true
        schema:
          type: string
      responses:
        '200':
          description: Success
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SendMessageDetailsResponse'
        '401':
            $ref: '#/components/responses/UnauthorizedError'
        '404':
            $ref: '#/components/responses/NotFoundError'
      security:
      - bearerAuth: []
    delete:
      summary: Cancel scheduled SMS message
      operationId: v1SmsMessagesMessageIdCancel
      parameters:
        - name: messageId
          in: path
          description: the sms message identifier
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Success
        '401':
          description: Access token is missing or invalid
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BaseResponse'
        '404':
          description: Resource not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BaseResponse'
        '409':
          description: Message is either not scheduled or is currently being sent/delivered
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BaseResponse'
      security:
        - bearerAuth: []
  /v1/sms/messages:
    get:
      summary: List SMS messages
      operationId: v1SmsMessagesList
      parameters:
      - name: status
        in: query
        description: The statuses of the SMS messages to seek
        required: false
        schema:
          uniqueItems: true
          type: array
          items:
            $ref: '#/components/schemas/SmsStatus'
      - name: page
        in: query
        description: The page number. Zero-based page index (0..N)
        required: false
        schema:
          minimum: 0
          type: integer
          format: int32
          default: 0
      - name: size
        in: query
        description: The number of items per page to be returned
        required: false
        schema:
          minimum: 0
          type: integer
          format: int32
          default: 10
      - name: sort
        in: query
        description: The sort order (ASC for ascending or DESC for descending) for
          the results. Sorting is done base on time of receiving the SMS message by
          API/system.
        required: false
        schema:
          type: string
          default: DESC
          enum:
          - ASC
          - DESC
      - name: maxAge
        in: query
        description: The maximum message age (in number of days) from receiving the
          SMS message by API/system. From 0 to 183 days (max value depends of platform
          configuration)
        required: false
        schema:
          minimum: 0
          type: integer
          format: int32
      responses:
        "401":
          description: Access token is missing or invalid
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ListMessagesResponse'
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ListMessagesResponse'
        "404":
          description: Resource not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ListMessagesResponse'
      security:
      - bearerAuth: []
    post:
      summary: Sends SMS message to phone number(s)
      requestBody:

        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SendMessageRequest'
        required: true
      callbacks:   # Callback definition
        smsStatusUpdateEvent:   # Event name
          '{$request.body#/callbackUrl}':   # The callback URL,
                                            # Refers to the passed URL
            post:
              requestBody:   # Contents of the callback message
                required: true
                content:
                  application/json:
                    schema:
                      $ref: '#/components/schemas/SmsStatusUpdateEvent'
              responses:   # Expected responses to the callback message
                '200':
                  description: Your server returns this code if it accepts the callback
        smsMessageEvent:   # Event name
          '{$request.body#/callbackUrl}':   # The callback URL,
                                            # Refers to the passed URL
            post:
              requestBody:   # Contents of the callback message
                required: true
                content:
                  application/json:
                    schema:
                      $ref: '#/components/schemas/SmsMessageEvent'
              responses:   # Expected responses to the callback message
                '200':
                  description: Your server returns this code if it accepts the callback
      responses:
        '202':
            description: Message submitted
            content:
              application/json:
                schema:
                  $ref: '#/components/schemas/SendMessagesListResponse'
        '400':
            $ref: '#/components/responses/BadRequestError'
        '401':
            $ref: '#/components/responses/UnauthorizedError'
        '405':
            $ref: '#/components/responses/NotAllowedError'
        '429':
            $ref: '#/components/responses/TooManyRequestsError'
        '503':
              $ref: '#/components/responses/ServiceUnavailableError'
      security:
      - bearerAuth: []
